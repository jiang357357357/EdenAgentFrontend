{
  "name": "mon-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/src/main.cjs",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "node Script/Project/dev.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:shell": "npm --prefix desktop run dev",
    "dev:desktop": "npm run dev",
    "build": "npm --prefix web run build",
    "build:dist": "MON_AGENT_AUTH_MODE=production npm run build",
    "package:linux": "electron-packager . mon-agent --platform=linux --arch=x64 --out=dist/app --overwrite --electron-version=42.4.0 --icon=desktop/assets/icon.png --ignore=^/dist/app --ignore=^/.git --ignore=^/node_modules --ignore=^/Script --ignore=^/web/node_modules --ignore=^/web/src --ignore=^/web/public --ignore=^/web/tsconfig\\.json$ --ignore=^/web/vite\\.config\\.ts$",
    "package:win": "electron-packager . mon-agent --platform=win32 --arch=x64 --out=dist/app --overwrite --electron-version=42.4.0 --icon=desktop/assets/icon.ico --ignore=^/dist/app --ignore=^/.git --ignore=^/node_modules --ignore=^/Script --ignore=^/web/node_modules --ignore=^/web/src --ignore=^/web/public --ignore=^/web/tsconfig\\.json$ --ignore=^/web/vite\\.config\\.ts$",
    "dist:linux": "npm run build:dist && npm run package:linux",
    "dist:win": "set MON_AGENT_AUTH_MODE=production&& npm run build && npm run package:win",
    "typecheck": "npm --prefix web run typecheck",
    "preview": "npm --prefix web run preview",
    "start": "npm run dev"
  },
  "workspaces": [
    "web",
    "desktop"
  ],
  "devDependencies": {
    "@electron/packager": "^20.0.1"
  }
}
