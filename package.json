{
  "name": "eden-agent-frontend",
  "private": true,
  "version": "1.10.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "desktop/src/main.cjs",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "node Script/Project/dev.mjs",
    "test:dev-smoke": "node Script/Project/dev.mjs --smoke-web",
    "test:process-runner": "node --test tests/process-runner.test.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:shell": "npm --prefix desktop run dev",
    "dev:desktop": "npm run dev",
    "build": "npm --prefix web run build",
    "build:dist": "EDEN_AGENT_AUTH_MODE=production npm run build",
    "build:pointer-observer:win": "npm --prefix desktop run build:pointer-observer",
    "package:linux": "node Script/Project/package_desktop.mjs linux x64",
    "package:win": "npm run build:pointer-observer:win && node Script/Project/package_desktop.mjs win32 x64",
    "dist:linux": "npm run build:dist && npm run package:linux",
    "dist:win": "set EDEN_AGENT_AUTH_MODE=production&& npm run build && npm run package:win",
    "typecheck": "npm --prefix web run typecheck",
    "preview": "npm --prefix web run preview",
    "start": "npm run dev",
    "package:mac": "node Script/Project/package_desktop.mjs darwin arm64",
    "archive:desktop": "node Script/Project/archive_desktop.mjs",
    "release:sign": "node Script/Project/sign_release.mjs",
    "release:verify": "node Script/Project/verify_release.mjs",
    "release:install": "node Script/Project/install_release.mjs",
    "release:select": "node Script/Project/select_version.mjs",
    "release:launch": "node Script/Project/launch_version.mjs",
    "release:launcher": "node Script/Project/setup_launcher.mjs",
    "release:install-archive": "node Script/Project/install_archive.mjs",
    "release:system-entry": "node Script/Project/setup_system_entry.mjs"
  },
  "workspaces": [
    "web",
    "desktop"
  ],
  "devDependencies": {
    "@electron/packager": "^20.0.1"
  }
}
