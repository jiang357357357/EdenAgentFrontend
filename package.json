{
  "name": "eden-agent-frontend",
  "private": true,
  "version": "1.10.1",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "desktop/src/main.cjs",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "node Script/Project/dev.mjs",
    "test:dev-smoke": "node Script/Project/dev.mjs --smoke-web",
    "test:process-runner": "node --test tests/process-runner.test.mjs",
    "dev:web": "npm --prefix web run dev",
    "dev:shell": "npm --prefix desktop run dev",
    "dev:desktop": "npm run dev",
    "build": "npm --prefix web run build",
    "build:dist": "EDEN_AGENT_AUTH_MODE=production npm run build",
    "build:pointer-observer:win": "npm --prefix desktop run build:pointer-observer",
    "package:linux": "electron-packager . eden-agent --platform=linux --arch=x64 --out=dist/app --overwrite --electron-version=42.4.0 --icon=desktop/assets/icon.png --extra-resource=../target/release/eden-agent-server --extra-resource=../Server/skills --extra-resource=../Server/connectors/manifests --ignore=^/dist/app --ignore=^/.git --ignore=^/node_modules --ignore=^/Script --ignore=^/web/node_modules --ignore=^/web/src --ignore=^/web/public --ignore=^/web/tsconfig\\.json$ --ignore=^/web/vite\\.config\\.ts$",
    "package:win": "npm run build:pointer-observer:win && electron-packager . eden-agent --platform=win32 --arch=x64 --out=dist/app --overwrite --electron-version=42.4.0 --icon=desktop/assets/icon.ico --extra-resource=../target/release/eden-agent-server.exe --extra-resource=../Server/skills --extra-resource=../Server/connectors/manifests --extra-resource=desktop/native/win32-pointer-observer/bin/edenagent-pointer-observer.exe --ignore=^/dist/app --ignore=^/.git --ignore=^/node_modules --ignore=^/Script --ignore=^/desktop/native/win32-pointer-observer/target --ignore=^/desktop/native/win32-pointer-observer/bin --ignore=^/web/node_modules --ignore=^/web/src --ignore=^/web/public --ignore=^/web/tsconfig\\.json$ --ignore=^/web/vite\\.config\\.ts$",
    "dist:linux": "npm run build:dist && npm run package:linux",
    "dist:win": "set EDEN_AGENT_AUTH_MODE=production&& npm run build && npm run package:win",
    "typecheck": "npm --prefix web run typecheck",
    "preview": "npm --prefix web run preview",
    "start": "npm run dev"
  },
  "workspaces": [
    "web",
    "desktop"
  ],
  "devDependencies": {
    "@electron/packager": "^20.0.1"
  }
}
